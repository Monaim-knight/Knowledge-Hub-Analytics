NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/portfolio_db
JWT_SECRET=replace_with_a_long_secure_random_value
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP / Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=Portfolio API <your_email@example.com>
CONTACT_NOTIFY_TO=your_email@example.com

# Initial admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_123456

