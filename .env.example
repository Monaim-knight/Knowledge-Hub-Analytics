# Express Portfolio Backend (used by /studio, /case-studies, /projects, /blog, /writing)
# Locally defaults to http://127.0.0.1:5000/api. In Vercel production, point to your deployed backend:
BACKEND_PUBLIC_URL="http://127.0.0.1:5000"
# BACKEND_API_BASE_URL="https://your-backend.onrender.com/api"

# Database (PostgreSQL — only needed for /posts, /dashboards, /discussions, /topics)
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio_dev"

# Auth (Phase 3)
NEXTAUTH_SECRET="generate-a-random-string-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Admin user (used by seed)
# ADMIN_EMAIL="your@email.com"
# ADMIN_NAME="Your Name"

# File uploads (Phase 6)
# UPLOAD_DIR="./uploads"
